{
  "name": "fefco-dieline-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "catalog:qa": "python3 scripts/build-catalog-qa.py",
    "format": "prettier --write src tests scripts/*.ts *.ts *.json index.html README.md docs/*.md",
    "format:check": "prettier --check src tests scripts/*.ts *.ts *.json index.html README.md docs/*.md",
    "generators:manifest": "vite-node scripts/generator-manifest.ts"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/svg-path-parser": "^1.1.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.8.11",
    "prettier": "^3.9.10",
    "svg-path-parser": "^1.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0"
}
